# Model Router — example environment file.
# Copy to a PRIVATE location (e.g. ~/.config/model-router/router.env, chmod 600)
# and reference it from the systemd unit via EnvironmentFile=. Never commit
# real values.

# Provider API keys (required for the corresponding adapter)
PROVIDER_A_API_KEY=CHANGE_ME
PROVIDER_B_API_KEY=CHANGE_ME

# Optional: override provider base URLs (defaults live in the adapters)
# HERMES_ROUTER_PROVIDER_A_BASE=https://provider-a.example/v1
# HERMES_ROUTER_PROVIDER_B_BASE=https://provider-b.example/min80/v1

# Instance identity (R8 §3): prod | canary | release-test | ...
# MODEL_ROUTER_INSTANCE_ID=prod

# Mutable state root (R8 §3). Per-instance GATEWAY_STATE_DIR wins for
# prod/canary subdirectories.
# MODEL_ROUTER_STATE_DIR=/home/youruser/model-router-data

# Inference auth (R8 §21): disabled | bearer
# MODEL_ROUTER_AUTH_MODE=bearer
# MODEL_ROUTER_PROVIDER_A_TOKEN=change-me-in-private-config

# Admin auth token (control plane) — MUST differ from the inference token
# MODEL_ROUTER_ADMIN_TOKEN=change-me-different
