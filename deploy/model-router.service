# Model Router production (127.0.0.1:4100)
# Install to ~/.config/systemd/user/ after editing paths for your host.
[Unit]
Description=Model Router production (127.0.0.1:4100)
After=network.target

[Service]
Type=exec
WorkingDirectory=/home/YOURUSER/model-router
EnvironmentFile=/home/YOURUSER/.config/model-router/router.env
Environment=PYTHONPATH=/home/YOURUSER/model-router
Environment=GATEWAY_V2_HOST=127.0.0.1
Environment=GATEWAY_V2_PORT=4100
Environment=MODEL_ROUTER_INSTANCE_ID=prod
Environment=GATEWAY_STATE_DIR=/home/YOURUSER/model-router-data/prod
Environment=GW_CONTROL_DB=/home/YOURUSER/model-router-data/control/control.db
Environment=GW_CONFIG=/home/YOURUSER/model-router-data/control/gateway-v2.json
ExecStart=/home/YOURUSER/model-router/.venv/bin/python -m uvicorn gateway.app:app --host 127.0.0.1 --port 4100 --no-access-log
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
KillMode=mixed

[Install]
WantedBy=default.target
